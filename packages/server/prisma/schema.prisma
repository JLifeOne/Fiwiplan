// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  displayName String?
  phone       String?   @unique
  email       String?   @unique
  locale      String?
  preferences Json?
  roles       String[]
  plans       Plan[]
  planMembers PlanMember[]
  tasks       Task[]
  messages    Message[]
  contributions Contribution[]
  ads         Ad[]
  moderationCases ModerationCase[] @relation("reporter")
  reviewedModerationCases ModerationCase[] @relation("reviewer")
}

model Plan {
  id          String    @id @default(cuid())
  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  title       String
  description String?
  startAt     DateTime?
  endAt       DateTime?
  location    String?
  culture     String?
  settings    Json?
  createdAt   DateTime  @default(now())
  members     PlanMember[]
  tasks       Task[]
  messages    Message[]
  guests      Guest[]
  contributions Contribution[]
  budgets     Budget[]
}

model PlanMember {
  plan      Plan     @relation(fields: [planId], references: [id])
  planId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String // owner, admin, member

  @@id([planId, userId])
}

model Task {
  id          String     @id @default(cuid())
  plan        Plan       @relation(fields: [planId], references: [id])
  planId      String
  title       String
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  status      TaskStatus @default(PENDING)
  dueAt       DateTime?
  checklist   Json[]
  attachments Json[]
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

model Message {
  id           String   @id @default(cuid())
  plan         Plan     @relation(fields: [planId], references: [id])
  planId       String
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  body         String?
  media        String[]
  voiceNoteUrl String?
  createdAt    DateTime @default(now())
  aiExtracted  Json?
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Guest {
  id         String @id @default(cuid())
  plan       Plan   @relation(fields: [planId], references: [id])
  planId     String
  name       String
  contact    String?
  rsvpStatus String
}

model Budget {
  id        String     @id @default(cuid())
  plan      Plan       @relation(fields: [planId], references: [id])
  planId    String
  title     String
  amount    Float
  category  String
  type      BudgetType
  createdAt DateTime   @default(now())
}

enum BudgetType {
  INCOME
  EXPENSE
}

model Contribution {
  id      String  @id @default(cuid())
  plan    Plan    @relation(fields: [planId], references: [id])
  planId  String
  user    User    @relation(fields: [userId], references: [id])
  userId  String
  kind    String // CASH or ITEM
  amount  Float?
  item    String?
  qty     Int?
}

model Ad {
  id          String    @id @default(cuid())
  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  title       String
  media       String[]
  category    String
  subcategory String
  geo         String?
  startAt     DateTime
  endAt       DateTime
  status      String // PENDING, APPROVED, REJECTED
  targets     Json?
  stats       AdStat?
}

model AdStat {
  ad           Ad      @relation(fields: [adId], references: [id])
  adId         String  @id
  impressions  Int
  taps         Int
  saves        Int
  shares       Int
  ctr          Float
}

model ModerationCase {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  reporter     User     @relation("reporter", fields: [reporterId], references: [id])
  reporterId   String
  reason       String
  action       String?
  reviewer     User?    @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId   String?
  resolvedAt   DateTime?
}
